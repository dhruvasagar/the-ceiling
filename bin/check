#!/bin/sh
# Integrity checks for the talk repo. Run from anywhere: bin/check [name...]
# Prints "ok <name>" or "FAIL <name>: <reason>"; exits 1 if anything failed.
# shellcheck disable=SC2329  # check_* functions are invoked by name below
cd "$(dirname "$0")/.." || exit 2
export PATH="$HOME/.asdf/shims:$PATH"
failed=0
TALK=talk/the-ceiling.org
REFS=references/README.md
ANALYSIS=analysis/yjit-vs-zjit.md

ok()   { echo "ok   $1"; }
fail() { echo "FAIL $1: $2"; failed=1; }
# verdict NAME REASON: ok when REASON is empty, otherwise fail with it
verdict() { if [ -z "$2" ]; then ok "$1"; else fail "$1" "$2"; fi; }

check_no_personal_paths() {
  hits=$(git ls-files -z --cached --others --exclude-standard \
           | xargs -0 grep -lE '/Users/[A-Za-z0-9_]|/private/tmp/[A-Za-z0-9_-]|/var/folders/[a-z0-9]' 2>/dev/null \
           | grep -v '^bin/check$' | tr '\n' ' ')
  verdict no_personal_paths "${hits:+absolute personal paths in: $hits}"
}

check_env() {
  why=""
  v=$(ruby -v 2>&1)
  case $v in *4.1.0preview1*) ;; *) why="ruby is '$v'; want 4.1.0-preview1 (asdf install ruby 4.1.0-preview1). " ;; esac
  ruby --yjit --yjit-call-threshold=1 --yjit-dump-disasm -e 'def f = 1; f' 2>&1 | grep -q '# Block:' \
    || why="${why}this Ruby prints no YJIT disassembly: build it with RUBY_CONFIGURE_OPTS='--enable-yjit=dev --enable-zjit=dev'. "
  ruby --zjit --zjit-call-threshold=1 --zjit-dump-hir -e 'def f = 1; f' 2>&1 | grep -q '^fn ' \
    || why="${why}this Ruby prints no ZJIT HIR (--zjit-dump-hir). "
  git ls-files --error-unmatch .tool-versions >/dev/null 2>&1 \
    || why="${why}.tool-versions is not committed (a global gitignore may hide it: git add -f .tool-versions). "
  ruby -ractive_support -e 1 >/dev/null 2>&1 \
    || why="${why}activesupport missing: gem install activesupport -v 8.1.4.1. "
  verdict env "$why"
}

check_tangle_current() {
  why=""
  if ! command -v emacs >/dev/null 2>&1; then
    verdict tangle_current "emacs not found: it is needed to generate src/ from talk/the-ceiling.org. "; return
  fi
  emacs --batch -Q --eval '(progn (require (quote ob-tangle)) (org-babel-tangle-file "talk/the-ceiling.org"))' \
    >/dev/null 2>&1 || why="tangle failed (emacs --batch). "
  git diff --quiet -- src/ 2>/dev/null || why="${why}src/ differs from talk/the-ceiling.org after tangling; commit the tangled files. "
  [ -f src/distance.rb ] || why="${why}src/distance.rb missing. "
  verdict tangle_current "$why"
}

# marker FILE PATTERN: FILE exists, is non-empty, and matches the ERE PATTERN
marker() {
  if [ ! -s "captures/$1" ]; then echo "captures/$1 missing or empty. "
  elif ! grep -qE -- "$2" "captures/$1"; then echo "captures/$1 lacks /$2/. "
  fi
}

check_captures() {
  why="$(marker yarv-distance.txt 'opt_minus')"
  why="$why$(marker yjit-distance.txt 'guard shape')"
  why="$why$(marker yjit-distance.txt 'defer_compilation')"
  why="$why$(marker zjit-distance.txt 'FixnumMult (v[0-9]+), (v[0-9]+)')"
  why="$why$(marker yjit-sq.txt 'call to Object#sq')"
  why="$why$(marker yjit-sq.txt 'guard arg0 fixnum')"
  why="$why$(marker yjit-sq.txt 'gen_direct_jmp: existing block')"
  why="$why$(marker yjit-sq-eager.txt 'call to Object#sq')"
  why="$why$(marker zjit-choppy-stats.txt '^side_exit_count: +0$')"
  why="$why$(marker yjit-choppy-stats.txt '^side_exit_count: +0$')"
  why="$why$(marker hwia-zjit-hir.txt 'PushInlineFrame :convert_key')"
  why="$why$(marker hwia-yjit-stats.txt '^code_region_size: +327,680$')"
  why="$why$(marker hwia-zjit-stats.txt '^code_region_bytes: +360,448$')"
  why="$why$(marker glimpse-zjit.txt 'PushInlineFrame :present\?')"
  why="$why$(marker glimpse-yjit.txt 'inlined simple ISEQ')"
  why="$why$(marker hwia-yjit-disasm.txt 'call to ActiveSupport::HashWithIndifferentAccess#convert_key')"
  why="$why$(marker zjit-sq.txt 'PushInlineFrame :sq')"
  why="$why$(marker hwia-source.txt 'Symbol === key')"
  why="$why$(marker hwia-zjit-stats.txt 'Hash#\[\]')"
  why="$why$(marker hwia-yjit-stats.txt 'invokesuper exit reasons')"
  why="$why$(marker how-yjit.txt 'distance@distance_log.rb:[0-9]+ \(index: [0-9]+\)')"
  why="$why$(marker how-zjit.txt 'distance@distance_log.rb')"
  why="$why$(marker zjit-calm.txt 'FixnumAdd (v[0-9]+), (v[0-9]+)')"
  why="$why$(marker zjit-calm.txt 'PushInlineFrame :double')"
  why="$why$(marker zjit-choppy.txt 'polymorphic fallback')"
  why="$why$(marker zjit-choppy.txt 'CCallWithFrame v[0-9]+, :Integer#\+')"
  why="$why$(marker yjit-choppy.txt 'call to String#\+')"
  # same-SSA-value multiply: ZJIT reuses the already-proved dx
  grep -qE 'FixnumMult (v[0-9]+), \1' captures/zjit-distance.txt 2>/dev/null \
    || why="${why}zjit-distance.txt has no 'FixnumMult vN, vN'. "
  verdict captures "$why"
}

# listings ORG CAPTURE_DIR: reasons (empty = every listing line is real)
listings() {
  [ -f bin/lib/check-listings.awk ] || { echo "bin/lib/check-listings.awk missing. "; return; }
  awk -f bin/lib/check-listings.awk "$1" | while IFS="$(printf '\t')" read -r files line; do
    if [ "$files" = "ERR" ]; then echo "$line. "; continue; fi
    want=$(printf '%s\n' "$line" | bin/normalize)
    found=""
    for f in $(echo "$files" | tr ',' ' '); do
      [ -f "$2/$f" ] || { echo "listing names missing capture $f. "; continue; }
      bin/normalize < "$2/$f" | grep -qF -- "$want" && found=1
    done
    [ -n "$found" ] || echo "line not in $files: '$want'. "
  done
}

check_listings_selftest() {
  t=$(mktemp -d)
  printf 'alpha   beta\n  guard arg0 fixnum @0x1f\nPushInlineFrame :sq, v116 (0x104b59e60), num_args=1\n' > "$t/c.txt"
  cat > "$t/good.org" <<'EOF'
# capture: c.txt
#+begin_example
YJIT                         ZJIT
guard arg0 fixnum            PushInlineFrame :sq, v116, num_args=1
 ...
alpha beta
#+end_example
EOF
  sed 's/alpha beta/invented line/' "$t/good.org" > "$t/bad.org"
  printf '#+begin_example\nalpha beta\n#+end_example\n' > "$t/nosrc.org"
  why=""
  [ -z "$(listings "$t/good.org" "$t")" ] || why="good listing rejected: $(listings "$t/good.org" "$t") "
  listings "$t/bad.org" "$t" | grep -q "invented line" || why="${why}invented line accepted. "
  listings "$t/nosrc.org" "$t" | grep -q "without a source" || why="${why}listing without '# capture:' accepted. "
  rm -rf "$t"
  verdict listings_selftest "$why"
}

check_listings() {
  verdict listings "$(listings talk/the-ceiling.org captures | tr '\n' ' ')"
}

DIAGRAMS="head-up sighting plateau ceiling turn-buoy two-beat-kick feed-stop"

check_diagrams() {
  why=""
  tmp=$(mktemp -d)
  for d in $DIAGRAMS; do
    f=talk/img/$d.svg
    o=talk/img/out/$d.svg
    if [ ! -f "$f" ]; then why="$why$f missing. "
    elif ! xmllint --noout "$f" 2>/dev/null; then why="$why$f is not valid XML. "
    elif ! grep -q 'viewBox="0 0 1600 900"' "$f"; then why="$why$f is not 16:9 (viewBox 0 0 1600 900). "
    elif [ ! -f "$o" ]; then why="$why$o missing (run bin/render-diagrams). "
    elif grep -q '<text' "$o"; then why="$why$o still has font-dependent text. "
    else
      rsvg-convert -f svg "$f" -o "$tmp/$d.svg" 2>/dev/null
      cmp -s "$tmp/$d.svg" "$o" || why="$why$o is stale (run bin/render-diagrams). "
    fi
  done
  rm -rf "$tmp"
  # every image the talk references exists
  # shellcheck disable=SC2013  # one path per match, no spaces possible
  for ref in $(grep -oE 'img/(out/)?[a-z0-9-]+\.svg' "$TALK" | sort -u); do
    [ -f "talk/$ref" ] || why="${why}talk references missing $ref. "
  done
  verdict diagrams "$why"
}

TAKEAWAY="YJIT compiles Ruby a bit at a time, deciding as it goes; ZJIT plans a whole method at once, so it can see through small method calls and pay less for them. That's the ceiling the ZJIT team set out to raise."

# What the audience sees on slides: exported headings' body text, minus
# speaker notes, listings, source blocks, verbatim quotes (their words are
# not ours to change), comments and :noexport: subtrees.
slide_text() {
  awk '
    /^\* / { skip = ($0 ~ /:noexport:/) }
    skip { next }
    /^#\+begin_(notes|example|src|quote)/ { blk = 1; next }
    /^#\+end_(notes|example|src|quote)/   { blk = 0; next }
    blk || /^#/ || /^[ \t]*:/ { next }
    { print }
  ' "$TALK"
}

check_stale_wording() {
  hits=$(grep -noiE 'bike|triath|a draw|\[VERIFY|parity in 4\.1|forgets what it learned at every method call|compiles on (the )?first call|straight away|first wave|YJIT guesses|guesses as it goes|which is what params is|is what params is|on the beach|time on the beach|prove the rest|proved a number once|the call disappears|The call is gone|No compiler sees inside C|adapting beats planning|simply adds another piece|Same checks, same work|stop paying for them' \
           "$TALK" talk/img/*.svg "$ANALYSIS" 2>/dev/null | tr '\n' ' ')
  verdict stale_wording "${hits:+stale wording: $hits}"
}

# Not a failure while drafting: a reminder that the projector must not show it.
check_repo_url() {
  n=$(grep -c '\[REPO-URL\]' "$TALK")
  if [ "$n" -gt 0 ]; then echo "warn repo_url: [REPO-URL] still appears $n times in $TALK; replace it before the talk"
  else ok repo_url; fi
}

check_jargon() {
  hits=$(slide_text | grep -oiE 'SSA|side.exit|PatchPoint|\bshapes?\b|Fixnum|basic block' | sort -u | tr '\n' ' ')
  verdict jargon "${hits:+jargon on slides (move to notes): $hits}"
}

check_timing() {
  total=$(awk '
    /^\* / { skip = ($0 ~ /:noexport:/) }
    !skip && /:DURATION:/ { split($2, t, ":"); s += t[1] * 60 + t[2] }
    END { print s + 0 }' "$TALK")
  why=""
  [ "$total" -ge 1110 ] && [ "$total" -le 1200 ] \
    || why="slides add up to $((total / 60)):$(printf %02d $((total % 60))); want 18:30-20:00"
  verdict timing "$why"
}

# Spoken notes must fit each slide's :DURATION: at ~140 words a minute.
# [Bracketed] text is stage direction or depth-if-asked, not spoken.
check_note_budget() {
  over=$(awk '
    function flush() {
      if (title != "" && secs > 0) {
        gsub(/\[[^]]*\]/, "", notes); n = split(notes, w, /[ \t\n]+/)
        words = 0; for (i = 1; i <= n; i++) if (w[i] != "") words++
        budget = int(secs * 140 / 60) + 10
        if (words > budget) printf "%s: %d words for %d s (max %d); ", title, words, secs, budget
      }
      title = ""; secs = 0; notes = ""
    }
    /^\* / { flush(); if ($0 !~ /:noexport:/) { title = substr($0, 3) } ; next }
    title != "" && /:DURATION:/ { split($2, t, ":"); secs = t[1] * 60 + t[2] }
    /^#\+begin_notes/ { inn = 1; next }
    /^#\+end_notes/   { inn = 0; next }
    inn && title != "" { notes = notes " " $0 }
    END { flush() }' "$TALK")
  verdict note_budget "$over"
}

check_narration() {
  if [ ! -f talk/narration.org ]; then verdict narration "talk/narration.org missing: run bin/narration. "; return
  fi
  if ! fresh=$(bin/narration - 2>&1); then fail narration "bin/narration failed: $fresh"; return; fi
  if printf '%s\n' "$fresh" | cmp -s - talk/narration.org; then ok narration
  else fail narration "talk/narration.org is out of date: run bin/narration"; fi
}

check_glimpse() {
  want=$(ruby bin/lib/glimpse.rb captures/glimpse-yjit.txt captures/glimpse-zjit.txt 2>&1)
  have=$(awk '/^# glimpse: rows generated/{p=1; next} p && /^\| =/{print} p && /^[^|]/{if (n++) exit}' "$TALK")
  if [ "$want" = "$have" ]; then ok glimpse
  else fail glimpse "slide table differs from captures (run: ruby bin/lib/glimpse.rb captures/glimpse-yjit.txt captures/glimpse-zjit.txt)"; fi
}

check_takeaway() {
  if tr '\n' ' ' < "$TALK" | tr -s ' ' | grep -qF -- "$TAKEAWAY"; then ok takeaway
  else fail takeaway "takeaway sentence not found verbatim"; fi
}

check_export() {
  html=talk/the-ceiling.html
  why=""
  bin/export >/dev/null 2>&1 || why="bin/export failed (run it to see why). "
  if [ ! -s "$html" ]; then
    why="${why}$html missing. "
  else
    [ "$TALK" -nt "$html" ] && why="${why}$html older than $TALK. "
    grep -q 'reveal.js@4.6.1' "$html" || why="${why}not using reveal.js@4.6.1. "
    grep -q 'class="notes"' "$html" || why="${why}speaker notes missing. "
    grep -q 'RevealHighlight' "$html" || why="${why}syntax highlighting plugin not loaded. "
    grep -qE '<code[^>]*class="[^"]*ruby' "$html" || why="${why}ruby code blocks not marked for highlighting. "
    grep -q '#+begin_' "$html" && why="${why}raw org markup leaked into HTML. "
    awk '/^\* / && !/:noexport:/ { sub(/^\* /, ""); print }' "$TALK" | while read -r h; do
      grep -qF -- "$h" "$html" || echo "slide missing from HTML: $h"
    done | grep -q . && why="${why}some slides missing from HTML. "
  fi
  verdict export "$why"
}


# citation numbers [n] used in a file
cites() { grep -oE '\[[0-9]+\]' "$1" 2>/dev/null | sort -u; }

check_references() {
  why=""
  if [ ! -s "$REFS" ]; then
    why="$REFS missing. "
  else
    for n in $(cites "$ANALYSIS"); do
      grep -qF -- "$n " "$REFS" || why="${why}$ANALYSIS cites $n, not in $REFS. "
    done
    if curl -sfI --max-time 5 https://www.ruby-lang.org/ >/dev/null 2>&1; then
      # shellcheck disable=SC2013  # one URL per match, no spaces
      for u in $(grep -oE 'https://[^ )>]+' "$REFS" | sort -u); do
        case $u in
          # publishers block scripted fetches (HTTP 403); ask Crossref instead
          https://doi.org/*) u="https://api.crossref.org/works/${u#https://doi.org/}" ;;
        esac
        curl -sfIL --max-time 15 -A 'the-ceiling-link-check' "$u" >/dev/null 2>&1 \
          || curl -sfL --max-time 15 -A 'the-ceiling-link-check' -o /dev/null "$u" 2>/dev/null \
          || why="${why}dead link: $u. "
      done
    else
      echo "warn references: offline, links not checked"
    fi
  fi
  verdict references "$why"
}

check_analysis() {
  why=""
  if [ ! -s "$ANALYSIS" ]; then
    verdict analysis "$ANALYSIS missing. "; return
  fi
  for h in "How CRuby runs code" "How YJIT works" "How ZJIT works" "Side by side" \
           "When and how each one compiles" "Experiments" "Where no JIT helps" \
           "Status and direction" "Threats to validity"; do
    grep -qE "^#+ .*$h" "$ANALYSIS" || why="${why}no section '$h'. "
  done
  # shellcheck disable=SC2013  # one path per match, no spaces
  for f in $(grep -oE '\.\./captures/[a-z0-9-]+\.txt' "$ANALYSIS" | sort -u); do
    [ -f "analysis/$f" ] || why="${why}broken capture link $f. "
  done
  grep -qiE 'buoy|swim' "$ANALYSIS" && why="${why}swim metaphor in the formal analysis. "
  verdict analysis "$why"
}

# --- run --------------------------------------------------------------------
all=$(grep -oE '^check_[a-z_]+\(\)' "$0" | tr -d '()')
[ $# -gt 0 ] && all="$*"
for c in $all; do
  case $c in check_*) ;; *) c=check_$c ;; esac
  "$c"
done
exit $failed
