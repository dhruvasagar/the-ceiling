#!/bin/sh
# Generate talk/narration.org: the whole talk as a rehearsal script, from
# the speaker notes in talk/the-ceiling.org (which stay the one source).
#   bin/narration          write talk/narration.org
#   bin/narration -        print to stdout
#
# Time estimate per slide (a rehearsal guide, not a measurement):
#   spoken words at 130 words a minute ([bracketed] text is not spoken)
#   + 10 s for each compiler listing or code block the room has to read
#   + 20 s for the live demo
#   + 30 s for each [STORY] beat still to be written (a placeholder budget)
#   + the quote, read aloud
unset CDPATH  # a CDPATH makes cd print the directory, polluting output
cd "$(dirname "$0")/.." || exit 2
out=talk/narration.org
[ "${1:-}" = "-" ] && out=/dev/stdout
tmp=$(mktemp) || exit 1

awk '
function clock(x) { x = int(x + 0.5); return sprintf("%d:%02d", int(x / 60), x % 60) }
function words(txt,   g, n, w, i, c) {
  g = txt; gsub(/\[[^]]*\]/, " ", g); n = split(g, w, /[ \t\n]+/); c = 0
  for (i = 1; i <= n; i++) if (w[i] ~ /[A-Za-z0-9]/) c++
  return c
}
function stories(txt,   g, c) { g = txt; c = gsub(/\[STORY/, "", g); return c }
# A listing is held until we know whether line notes (ol.ann-notes) follow;
# then each note is printed beside its line, as on the slide.
function flushlst(   i, wd, fmt, ln) {
  if (!held) return
  wd = 0; for (i = 1; i <= nlb; i++) if (length(LB[i]) > wd) wd = length(LB[i])
  fmt = "%-" wd "s  <- %s"
  for (i = 1; i <= nlb; i++) {
    ln = (i in ANN) ? sprintf(fmt, LB[i], ANN[i]) : LB[i]
    screen = screen ln "\n"
  }
  screen = screen "#+end_example\n"
  held = 0; nlb = 0; split("", LB); split("", ANN)
}
function finish() {
  if (title == "") return
  N++; T[N] = title; D[N] = secs; NOTES[N] = notes; SCREEN[N] = screen
  w = words(notes); s = stories(notes); qw = words(quote)
  est = (w + qw) * 60 / 130 + 10 * blocks + 20 * live + 30 * s
  W[N] = w; S[N] = s; E[N] = est; B[N] = blocks; L[N] = live
  title = ""; secs = 0; notes = ""; screen = ""; blocks = 0; live = 0; quote = ""
}
held && !inx && $0 !~ /^#\+begin_export html/ { flushlst() }
/^\* / {
  finish()
  if ($0 !~ /:noexport:/) title = substr($0, 3)
  next
}
title == "" { next }
/:DURATION:/ { split($2, t, ":"); secs = t[1] * 60 + t[2]; next }
/^# LIVE/ { live = 1; next }
/^#\+begin_notes/ { inn = 1; next }
/^#\+end_notes/ { inn = 0; next }
inn { notes = notes $0 "\n"; next }
/^#\+begin_quote/ { inq = 1; next }
/^#\+end_quote/ { inq = 0; screen = screen "- quote: " qtxt "\n"; qtxt = ""; next }
inq { quote = quote " " $0; qtxt = qtxt $0 " "; next }
/^#\+begin_(example|src)/ {
  inb = 1; blocks++
  kind = ($0 ~ /begin_src/) ? "code" : "listing"
  screen = screen "- " kind (cap != "" ? " (captures/" cap ")" : "") ":\n#+begin_example\n"; cap = ""
  next
}
/^#\+end_(example|src)/ { inb = 0; held = 1; next }
inb { LB[++nlb] = $0; next }
/^#\+begin_export html/ { inx = 1; next }
/^#\+end_export/ { inx = 0; if (annm) { annm = 0; flushlst() }; next }
inx && /<ol class="ann-notes">/ { annm = 1; next }
inx && annm && /<li data-l="/ {
  k = $0; sub(/^.*data-l="/, "", k); sub(/".*$/, "", k)
  xt = $0; sub(/^<li[^>]*>/, "", xt); sub(/<\/li>$/, "", xt); gsub(/<[^>]*>/, "", xt)
  ANN[k + 0] = xt; next
}
inx && annm { next }
inx { if (held) flushlst(); xt = $0; gsub(/<[^>]*>/, "", xt); screen = screen "- " xt "\n"; next }
/^\|/ { if (!intable) screen = screen "\n"; intable = 1; screen = screen $0 "\n"; next }
intable && !/^\|/ { intable = 0; screen = screen "\n" }
/^# capture: / { cap = $0; sub(/^# capture: /, "", cap); next }
/^#\+attr_html: :alt / { alt = $0; sub(/^#\+attr_html: :alt /, "", alt); next }
/^\[\[file:img\// { f = $0; gsub(/^\[\[file:|\]\]$/, "", f); screen = screen "- diagram " f (alt != "" ? ": " alt : "") "\n"; alt = ""; next }
/^#/ || /^:/ || /^[ \t]*$/ { next }
{ line = $0; sub(/^- /, "", line); gsub(/=/, "~", line); screen = screen "- " line "\n" }
END {
  flushlst()
  finish()
  print "#+TITLE: The Ceiling — narration"
  print "#+OPTIONS: toc:nil num:nil"
  print "#+STARTUP: showall"
  print ""
  print "# GENERATED by bin/narration from the speaker notes in the-ceiling.org."
  print "# Do not edit: change the notes there, then run bin/narration."
  print ""
  print "The whole talk as a rehearsal script, slide by slide: when it starts,"
  print "what is on screen, and what to say. Text in [brackets] is stage"
  print "direction or depth-if-asked, not spoken. [STORY: …] beats are yours to"
  print "write. Estimates assume 130 spoken words a minute, plus time for the room"
  print "to read listings (10 s each), the live demo (20 s) and each unwritten"
  print "STORY beat (30 s)."
  print ""
  print "* Timing"
  print ""
  print "| # | Starts | Slide | Budget | Estimate | Spare | Notes |"
  print "|---+--------+-------+--------+----------+-------+-------|"
  start = 0; tb = 0; te = 0
  for (i = 1; i <= N; i++) {
    flag = ""
    if (S[i]) flag = flag "STORY "
    if (L[i]) flag = flag "live "
    if (E[i] > D[i] + 5) flag = flag "OVER "
    else if (D[i] - E[i] >= 20) flag = flag "room "
    printf "| %d | %s | %s | %s | %s | %s | %s |\n", i, clock(start), T[i], clock(D[i]), clock(E[i]), (D[i] >= E[i] ? "" : "-") clock(D[i] >= E[i] ? D[i] - E[i] : E[i] - D[i]), flag
    start += D[i]; tb += D[i]; te += E[i]
  }
  print "|---+--------+-------+--------+----------+-------+-------|"
  printf "|   |        | *Total* | *%s* | *%s* | *%s* | |\n", clock(tb), clock(te), (tb >= te ? "" : "-") clock(tb >= te ? tb - te : te - tb)
  print ""
  print "/room/: 20 s or more spare. /OVER/: likely to run over its budget."
  print ""
  print "* Narration"
  start = 0
  for (i = 1; i <= N; i++) {
    print ""
    printf "** %d. %s  (%s, %s)\n", i, T[i], clock(start), clock(D[i])
    print ""
    print "/On screen:/"
    printf "%s", SCREEN[i]
    print ""
    print "/Say:/"
    print ""
    printf "%s", NOTES[i]
    if (i < N) { print ""; printf "/Next: %s/\n", T[i + 1] }
    start += D[i]
  }
}' talk/the-ceiling.org > "$tmp" || { echo "narration: generator failed" >&2; rm -f "$tmp"; exit 1; }
if [ "$out" = /dev/stdout ]; then cat "$tmp"; rm -f "$tmp"
else mv "$tmp" "$out"; echo "wrote $out"; fi
